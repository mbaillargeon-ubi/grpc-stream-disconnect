{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "NLog": {
    "throwConfigExceptions": true,
    "targets": {
      "async": true,
      "logfile": {
        "type": "File",
        "fileName": "${basedir}/logs/greeterservice.txt",
        "archiveFileName": "${basedir}/logs/archive/greeterservice_{#}.txt",
        "archiveDateFormat": "yyyy-MM-dd-HH_mm_ss",
        "archiveNumbering": "Date",
        "archiveOldFileOnStartup": "True",
        "archiveAboveSize": "262144000",
        "maxArchiveFiles": "5",
        "archiveEvery": "Day",
        "Layout": "${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
      },
      "console": {
        "type": "Console",
        "Layout": "${longdate} ${level}: ${message}  ${exception:format=tostring}"
      }
    },
    "rules": {
      // number+name to allow override rules through env variables (or user secrets) as described here:
      // https: //github.com/NLog/NLog.Extensions.Logging/wiki/NLog-configuration-with-appsettings.json#logging-rule-override
      "0_system": {
        "logger": "System.*",
        "finalMinLevel": "Debug"
      },
      "1_microsoft": {
        "logger": "Microsoft.*",
        "finalMinLevel": "Debug"
      },
      "2_grpc": {
        "logger": "Grpc.AspNetCore.*",
        "finalMinLevel": "Debug"
      },
      "3_microsoftlifetime": {
        "logger": "Microsoft.Hosting.Lifetime*",
        "finalMinLevel": "Debug"
      },
      "4_logfile": {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "logfile"
      },
      "5_console": {
        "logger": "*",
        "minLevel": "Debug",
        "writeTo": "console"
      }
    }
  }
}
